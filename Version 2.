import datetime

event_title = input("Enter event title: ")
year = input("Enter year: ")
month = input("Enter month: ")
day = input("Enter day: ")

# Clean up the text inputs
event_title = event_title.strip().upper()
month = month.strip().capitalize()
year = year.strip()
day = day.strip()

# Turn the words and numbers into a real date
full_date = month + " " + day + " " + year
event_date = datetime.datetime.strptime(full_date, "%B %d %Y")

print()
print("Formatted Output:")
print("Event:", event_title)
print("Date:", event_date.strftime("%B"), str(event_date.day) + ",", event_date.year)
print("Year:", event_date.year)
print("Month:", event_date.strftime("%B"))
print("Day:", event_date.day)
print("Weekday:", event_date.strftime("%A"))
